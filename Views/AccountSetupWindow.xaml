<Window x:Class="p2p.Views.AccountSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание учётной записи" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Assets/app.ico"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="24">
        <TextBlock Text="Создание учётной записи" Style="{StaticResource DialogTitle}" Margin="0,0,0,6"/>
        <TextBlock Text="Это имя увидят другие пользователи приложения в локальной сети."
                   Style="{StaticResource DialogHint}" Margin="0,0,0,18"/>

        <TextBlock Text="Ваше имя" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" MaxLength="40"/>

        <Button Content="Создать" Margin="0,24,0,0"
                Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
    </StackPanel>
</Window>
