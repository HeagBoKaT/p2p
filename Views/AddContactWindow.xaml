<Window x:Class="p2p.Views.AddContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить контакт" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=AddressBox}">
    <StackPanel Margin="24">
        <TextBlock Text="Добавить контакт" Style="{StaticResource DialogTitle}" Margin="0,0,0,6"/>
        <TextBlock Text="Укажите адрес вручную, если автоматическое обнаружение в сети недоступно."
                   Style="{StaticResource DialogHint}" Margin="0,0,0,18"/>

        <TextBlock Text="IP-адрес и порт" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AddressBox"/>
        <TextBlock Text="Например: 192.168.1.5:45454" Style="{StaticResource DialogHint}" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Отмена" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Добавить" Width="118"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
